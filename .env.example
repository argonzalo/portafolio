# Copiar a `.env` local. En Vercel: Project → Settings → Environment Variables
# (o las que inyecta el Marketplace de Upstash). Esquema tipado en `astro.config.ts`
# vía `astro:env` — ver docs/plan/04-agente-ia.md §2.

# OpenAI (servidor; nombres propios del proyecto)
OPEN_AI_API_KEY=
OPEN_AI_MODEL=gpt-6-luna
OPEN_AI_MODEL_FALLBACK=gpt-5.4-mini

# Upstash Redis (Marketplace de Vercel; también pueden existir KV_REST_API_*)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Guía
GUIDE_ENABLED=false
GUIDE_DAILY_BUDGET_USD=5
GUIDE_SESSION_SECRET=
