---
import BaseLayout from "@/layouts/BaseLayout.astro"
---

<BaseLayout title="Página no encontrada" description="La página que buscas no existe.">
  <section class="mx-auto flex min-h-[60svh] w-full max-w-3xl flex-col justify-center gap-4 px-6 py-16">
    <p class="text-muted-foreground text-sm font-medium tracking-wide uppercase">404</p>
    <h1 class="text-3xl font-semibold tracking-tight">Esta página no existe.</h1>
    <a href="/" class="text-sm underline-offset-4 hover:underline">Volver al inicio</a>
  </section>
</BaseLayout>
