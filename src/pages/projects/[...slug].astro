---
import { ProjectGallery } from "@/components/projects/ProjectGallery"
import ProjectMeta from "@/components/projects/ProjectMeta.astro"
import ProjectParts from "@/components/projects/ProjectParts.astro"
import ProjectToolbar from "@/components/projects/ProjectToolbar.astro"
import ProjectLayout from "@/layouts/ProjectLayout.astro"
import { getProjectRoutes } from "@/lib/projects"
import type { Project } from "@/lib/projects"

export function getStaticPaths() {
  return getProjectRoutes()
}

type Props = {
  project: Project
}

const { project } = Astro.props
---

<ProjectLayout title={project.title} description={project.cardDescription}>
  <ProjectToolbar slot="toolbar" project={project} />

  <div class="mx-auto flex w-full max-w-[100rem] flex-col gap-10 px-5 py-8 sm:px-8 lg:px-12">
    <p class="text-muted-foreground max-w-4xl text-base leading-relaxed text-pretty sm:text-lg">
      {project.description}
    </p>

    <div class="flex min-w-0 flex-col gap-8">
      <ProjectMeta project={project} />

      {project.parts && project.parts.length > 0 && <ProjectParts parts={project.parts} />}

      {
        project.organization && (
          <section class="border-border bg-muted/30 flex max-w-4xl flex-col gap-2 rounded-2xl border p-5">
            <h3 class="text-muted-foreground text-sm font-medium tracking-wide uppercase">
              Sobre {project.organization.name}
            </h3>
            <p class="text-muted-foreground text-sm leading-relaxed text-pretty">
              {project.organization.description}
            </p>
            <p class="text-muted-foreground flex flex-wrap items-center gap-x-4 gap-y-1 text-xs">
              <span class="inline-flex items-center gap-1.5">
                <span class="icon-[tabler--calendar] size-3.5 bg-current" aria-hidden="true" />
                {project.organization.period}
              </span>
              {project.organization.location && (
                <span class="inline-flex items-center gap-1.5">
                  <span class="icon-[tabler--map-pin] size-3.5 bg-current" aria-hidden="true" />
                  {project.organization.location}
                </span>
              )}
            </p>
          </section>
        )
      }

      <section class="flex flex-col gap-3">
        <h3 class="text-muted-foreground text-sm font-medium tracking-wide uppercase">
          Galería
        </h3>
        <ProjectGallery client:load images={project.images} title={project.title} />
      </section>
    </div>
  </div>
</ProjectLayout>
