---
import { ProjectGallery } from "@/components/projects/ProjectGallery"
import ProjectMeta from "@/components/projects/ProjectMeta.astro"
import ProjectToolbar from "@/components/projects/ProjectToolbar.astro"
import SubprojectNav from "@/components/projects/SubprojectNav.astro"
import { StackBadge } from "@/components/portfolio/StackBadge"
import ProjectLayout from "@/layouts/ProjectLayout.astro"
import { getProjectRoutes } from "@/lib/projects"
import type { Project, ProjectSubproject } from "@/lib/projects"

export function getStaticPaths() {
  return getProjectRoutes()
}

type Props = {
  project: Project
  subproject: ProjectSubproject | null
}

const { project, subproject } = Astro.props
const view = subproject ?? {
  title: project.title,
  period: project.period,
  stack: project.stack,
  description: project.description,
  images: project.images,
  active: project.active,
}
---

<ProjectLayout title={view.title} description={project.cardDescription}>
  <ProjectToolbar slot="toolbar" project={project} />

  <div class="mx-auto flex w-full max-w-[100rem] flex-col gap-10 px-5 py-8 sm:px-8 lg:px-12">
    <p class="text-muted-foreground max-w-4xl text-base leading-relaxed text-pretty sm:text-lg">
      {project.description}
    </p>

    <div class="flex flex-col gap-8 lg:flex-row lg:items-start">
      <SubprojectNav project={project} currentId={subproject?.id} />

      <div class="flex min-w-0 flex-1 flex-col gap-8">
        {
          subproject ? (
            <ProjectMeta item={subproject} location={project.location} />
          ) : (
            <section class="flex flex-col gap-6">
              <p class="text-muted-foreground flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
                <span class="inline-flex items-center gap-1.5">
                  <span class="icon-[tabler--calendar] size-4 bg-current" aria-hidden="true" />
                  {project.period}
                </span>
                {project.location && (
                  <span class="inline-flex items-center gap-1.5">
                    <span class="icon-[tabler--map-pin] size-4 bg-current" aria-hidden="true" />
                    {project.location}
                  </span>
                )}
              </p>
              <ul class="flex flex-wrap gap-1.5">
                {project.stack.map((tech) => (
                  <li>
                    <StackBadge name={tech} />
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <section class="flex flex-col gap-3">
          <h3 class="text-muted-foreground text-sm font-medium tracking-wide uppercase">
            Galería
          </h3>
          <ProjectGallery client:load images={view.images} title={view.title} />
        </section>
      </div>
    </div>
  </div>
</ProjectLayout>
