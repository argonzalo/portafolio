---
/**
 * Laboratorio del Kit de Escena (T-A18, `03-escenas.md` §2).
 *
 * Igual que `/lab/thread`, está habilitado en desarrollo y en los previews de
 * Vercel para revisión humana en desktop y teléfono real.
 */
import { KitLab } from "@/scenes/kit/KitLab"
import "@/styles/globals.css"

const enabled = import.meta.env.DEV || process.env.VERCEL_ENV === "preview"
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="robots" content="noindex" />
    <title>Lab · Kit de escena</title>
  </head>
  <body class="overflow-hidden bg-[#061121] text-white antialiased">
    {
      enabled ? (
        <KitLab client:only="react" />
      ) : (
        <main class="flex min-h-svh items-center justify-center p-6 font-mono text-sm text-white/60">
          <p>
            Laboratorio no disponible.{" "}
            <a href="/" class="underline">
              Volver al sitio
            </a>
          </p>
        </main>
      )
    }
  </body>
</html>
