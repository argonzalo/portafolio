---
/**
 * Recorrido de la home (ADR-007 / T-A11).
 * Sitio de una sola página: las fichas de proyectos abren en dialog modal.
 */
import AboutChapter from "@/components/journey/AboutChapter.astro"
import ArchiveChapter from "@/components/journey/ArchiveChapter.astro"
import ContactChapter from "@/components/journey/ContactChapter.astro"
import HeroChapter from "@/components/journey/HeroChapter.astro"
import ManifestoChapter from "@/components/journey/ManifestoChapter.astro"
import SceneChapter from "@/components/journey/SceneChapter.astro"
import { ProjectDialog } from "@/components/dialogs/ProjectDialog"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { getProjects } from "@/lib/projects"

const allProjects = getProjects()
---

<BaseLayout>
  <HeroChapter />
  <ManifestoChapter />

  <SceneChapter
    id="vibo"
    label="Vibo"
    eyebrow="Primera línea · escena"
    summary="Análisis de pádel con visión por computadora."
  />
  <SceneChapter
    id="pirp"
    label="Pirp"
    eyebrow="Primera línea · escena"
    summary="Señal editorial y lectura de reputación en tiempo real."
  />
  <SceneChapter
    id="naturalis"
    label="Naturalis"
    eyebrow="Primera línea · escena"
    summary="Contraste deliberado: calma y diseño sereno."
  />
  <SceneChapter
    id="banner-2"
    label="Banner 2.0"
    eyebrow="Primera línea · escena"
    summary="Escala en pantallas y comunicación comercial."
  />

  {/* Segunda línea: viñeta AGNT (Starbene y Cielo y Mar pasan a tercera línea) */}
  <SceneChapter
    id="agnt"
    label="AGNT"
    eyebrow="Segunda línea · viñeta"
    summary="Pizarra táctica y gestión deportiva con inteligencia aplicada."
  />

  <ArchiveChapter />
  <AboutChapter />
  <ContactChapter />

  {/* Modal de detalle de proyecto para el sitio de una sola página */}
  <ProjectDialog client:load projects={allProjects} />
</BaseLayout>
