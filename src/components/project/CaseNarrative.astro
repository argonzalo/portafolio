---
import type { ProjectData } from "@/content/schema"
import { cn } from "@/lib/utils"

import CaseSection from "./CaseSection.astro"
import { isDraftText } from "./statusLabel"

type Props = {
  project: ProjectData
}

const { project } = Astro.props

const approach = project.approach
const decisions = project.decisions
const challenges = project.challenges
const impact = project.impact
---

<div class="flex flex-col gap-12 sm:gap-14">
  <CaseSection title="Problema" id="problema">
    <p
      class={cn(
        "text-muted-foreground max-w-3xl text-base leading-relaxed text-pretty sm:text-lg",
        isDraftText(project.problem) && "opacity-70"
      )}
    >
      {project.problem}
    </p>
  </CaseSection>

  <CaseSection title="Enfoque" id="enfoque">
    <ol class="max-w-3xl list-none space-y-3">
      {
        approach.map((step, index) => (
          <li class="flex gap-4">
            <span
              class="text-muted-foreground/70 w-8 shrink-0 pt-0.5 font-mono text-sm tabular-nums"
              aria-hidden="true"
            >
              {String(index + 1).padStart(2, "0")}
            </span>
            <p
              class={cn(
                "text-muted-foreground text-base leading-relaxed text-pretty",
                isDraftText(step) && "opacity-70"
              )}
            >
              {step}
            </p>
          </li>
        ))
      }
    </ol>
  </CaseSection>

  {
    decisions.length > 0 && (
      <CaseSection title="Decisiones" id="decisiones">
        <ul class="max-w-3xl space-y-6">
          {decisions.map((item) => (
            <li class="border-border border-l-2 pl-4">
              <p
                class={cn(
                  "text-foreground text-base font-medium text-pretty",
                  isDraftText(item.decision) && "opacity-70"
                )}
              >
                {item.decision}
              </p>
              <p
                class={cn(
                  "text-muted-foreground mt-1.5 text-sm leading-relaxed text-pretty sm:text-base",
                  isDraftText(item.why) && "opacity-70"
                )}
              >
                {item.why}
              </p>
            </li>
          ))}
        </ul>
      </CaseSection>
    )
  }

  {
    challenges.length > 0 && (
      <CaseSection title="Desafíos" id="desafios">
        <ul class="max-w-3xl space-y-6">
          {challenges.map((item) => (
            <li class="flex flex-col gap-2">
              <p
                class={cn(
                  "text-foreground text-base font-medium text-pretty",
                  isDraftText(item.challenge) && "opacity-70"
                )}
              >
                {item.challenge}
              </p>
              <p
                class={cn(
                  "text-muted-foreground text-sm leading-relaxed text-pretty sm:text-base",
                  isDraftText(item.solution) && "opacity-70"
                )}
              >
                {item.solution}
              </p>
            </li>
          ))}
        </ul>
      </CaseSection>
    )
  }

  <CaseSection title="Resultado" id="resultado">
    {
      impact.length > 0 ? (
        <ul class="flex flex-wrap gap-x-8 gap-y-4">
          {impact.map((item) => (
            <li class="flex min-w-[8rem] flex-col gap-1">
              <span class="text-foreground text-3xl font-semibold tracking-tight tabular-nums sm:text-4xl">
                {item.value}
              </span>
              <span class="text-muted-foreground text-sm text-pretty">{item.label}</span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-muted-foreground max-w-3xl text-base leading-relaxed text-pretty opacity-70">
          TODO(humano): qué cambió después (números si hay).
        </p>
      )
    }
  </CaseSection>
</div>
