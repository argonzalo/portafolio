---
type Props = {
  title: string
  id: string
}

const { title, id } = Astro.props
---

<section class="flex flex-col gap-4" aria-labelledby={id}>
  <h2 id={id} class="text-foreground text-xl font-semibold tracking-tight sm:text-2xl">
    {title}
  </h2>
  <div class="flex flex-col gap-4">
    <slot />
  </div>
</section>
