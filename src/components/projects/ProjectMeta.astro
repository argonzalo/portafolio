---
import { Alert, AlertDescription, AlertTitle } from "@/components/ui/alert"
import { StackBadge } from "@/components/portfolio/StackBadge"
import type { Project } from "@/lib/projects"
import { displayUrl } from "@/lib/utils"

type Props = {
  project: Project
}

const { project } = Astro.props
---

<section class="flex flex-col gap-6">
  <p class="text-muted-foreground flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
    <span class="inline-flex items-center gap-1.5">
      <span class="icon-[tabler--calendar] size-4 bg-current" aria-hidden="true"></span>
      {project.period}
    </span>
    {
      project.location && (
        <span class="inline-flex items-center gap-1.5">
          <span class="icon-[tabler--map-pin] size-4 bg-current" aria-hidden="true"></span>
          {project.location}
        </span>
      )
    }
  </p>

  {
    project.alert && (
      <Alert variant="warning">
        <span
          class="icon-[tabler--alert-triangle] mt-0.5 size-4 shrink-0 bg-current"
          aria-hidden="true"
        />
        <div class="flex flex-col gap-1">
          <AlertTitle>Nota</AlertTitle>
          <AlertDescription>{project.alert}</AlertDescription>
        </div>
      </Alert>
    )
  }

  {
    project.stats && project.stats.length > 0 && (
      <p class="text-foreground flex flex-wrap items-center gap-x-4 gap-y-1 text-sm font-medium">
        {project.stats.map((stat) => (
          <span class="inline-flex items-center gap-1.5">
            <span class="icon-[tabler--chart-dots] size-4 bg-current text-muted-foreground" aria-hidden="true" />
            {stat}
          </span>
        ))}
      </p>
    )
  }

  <ul class="flex flex-wrap gap-1.5">
    {
      project.stack.map((tech) => (
        <li>
          <StackBadge name={tech} />
        </li>
      ))
    }
  </ul>

  {
    project.url && (
      <a
        href={project.url}
        target="_blank"
        rel="noopener noreferrer"
        class="border-border bg-muted/60 text-foreground hover:border-primary/40 hover:bg-muted inline-flex w-fit max-w-full items-center gap-1.5 rounded-full border px-3 py-1.5 text-sm font-medium transition-colors"
      >
        <span class="icon-[tabler--link] size-3.5 shrink-0 bg-current" aria-hidden="true"></span>
        <span class="truncate underline decoration-primary/50 underline-offset-4">
          {displayUrl(project.url)}
        </span>
        <span class="icon-[tabler--external-link] size-3.5 shrink-0 bg-current opacity-70" aria-hidden="true"></span>
        <span class="sr-only">(se abre en una pestaña nueva)</span>
      </a>
    )
  }
</section>
