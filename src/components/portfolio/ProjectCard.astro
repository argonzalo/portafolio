---
type Props = {
  href: string
  title: string
  description: string
  stack: string[]
  experimental?: boolean
}

const { href, title, description, stack, experimental = false } = Astro.props
---

<article
  class="border-border bg-card hover:border-foreground/20 rounded-xl border p-6 transition-colors"
>
  <a href={href} class="flex flex-col gap-4">
    <div class="flex items-start justify-between gap-4">
      <h2 class="text-lg font-medium tracking-tight">{title}</h2>
      {
        experimental && (
          <span class="bg-primary/20 text-primary-foreground rounded-full px-2 py-0.5 text-xs font-medium">
            Experimento
          </span>
        )
      }
    </div>
    <p class="text-muted-foreground text-sm leading-relaxed">{description}</p>
    <ul class="flex flex-wrap gap-2">
      {
        stack.map((item) => (
          <li class="bg-muted text-muted-foreground rounded-md px-2 py-1 text-xs">
            {item}
          </li>
        ))
      }
    </ul>
  </a>
</article>
