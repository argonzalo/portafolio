---
type Props = {
  eyebrow?: string
  title: string
  description?: string
}

const { eyebrow, title, description } = Astro.props
---

<header class="flex max-w-2xl flex-col gap-3">
  {
    eyebrow && (
      <p class="text-muted-foreground text-sm font-medium tracking-wide uppercase">
        {eyebrow}
      </p>
    )
  }
  <h1 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
    {title}
  </h1>
  {
    description && (
      <p class="text-muted-foreground text-base leading-relaxed text-pretty">
        {description}
      </p>
    )
  }
</header>
