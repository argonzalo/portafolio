---
/**
 * Placeholder del hero (copy y animación en T-A12).
 * 100 % HTML para LCP; sin canvas en este bloque.
 */
import ChapterSection from "@/components/journey/ChapterSection.astro"
---

<ChapterSection id="hero" label="Apertura" class="bg-background/70 backdrop-blur-sm">
  <p
    class="text-muted-foreground text-sm font-medium tracking-wide uppercase"
  >
    Hero · placeholder T-A12
  </p>
  <h1
    class="mt-3 max-w-3xl text-4xl font-semibold tracking-tight text-balance sm:text-5xl lg:text-6xl"
  >
    Tu próxima gran idea hecha realidad
  </h1>
  <p
    class="text-muted-foreground mt-5 max-w-2xl text-base leading-relaxed text-pretty sm:text-lg"
  >
    Diseño y construyo productos digitales, automatizaciones y soluciones de
    inteligencia artificial para negocios que estén listos para un siguiente
    paso.
  </p>
  <p class="text-muted-foreground/80 mt-8 max-w-xl text-sm leading-relaxed">
    El copy definitivo, tags y animación con SplitText llegan en T-A12. El hilo
    conductor arranca aquí cuando exista T-A13.
  </p>
</ChapterSection>
