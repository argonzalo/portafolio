---
/**
 * Hablemos — CTA de cierre. El contacto también está siempre en el header.
 */
import ChapterSection from "@/components/journey/ChapterSection.astro"
import { buttonVariants } from "@/components/ui/button"
import { contacts } from "@/lib/site"
---

<ChapterSection id="contact" label="Hablemos" tall={false} class="bg-background/70">
  <p
    class="text-muted-foreground text-sm font-medium tracking-wide uppercase"
  >
    Hablemos
  </p>
  <h2
    class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight text-balance sm:text-4xl"
  >
    Conversemos.
  </h2>
  <p class="text-muted-foreground mt-3 max-w-xl text-base leading-relaxed text-pretty">
    Un proyecto, una colaboración o una oportunidad. El hilo vuelve al inicio
    cuando exista el cierre cíclico (T-A34).
  </p>
  <div class="mt-8 flex flex-wrap gap-3">
    {
      contacts.map((item) => (
        <a
          href={item.href}
          class={buttonVariants({ variant: item.variant, size: "lg" })}
          target={item.external ? "_blank" : undefined}
          rel={item.external ? "noopener noreferrer" : undefined}
        >
          <span
            class:list={[item.iconClass, "size-5 shrink-0 bg-contain"]}
            aria-hidden="true"
          />
          {item.label}
        </a>
      ))
    }
  </div>
</ChapterSection>
