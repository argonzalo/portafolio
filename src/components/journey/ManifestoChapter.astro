---
import ChapterSection from "@/components/journey/ChapterSection.astro"
import { manifesto } from "@/lib/site"
---

<ChapterSection id="manifesto" label="Cómo pienso" class="manifesto-chapter">
  <div class="manifesto-copy">
    <h2
      class="max-w-md text-lg leading-relaxed text-muted-foreground sm:text-xl"
    >
      {manifesto.title}
    </h2>
    <ul class="manifesto-phrases" aria-label="Mi forma de trabajar">
      {
        manifesto.phrases.map((phrase) => (
          <li data-manifesto-phrase>{phrase}</li>
        ))
      }
    </ul>
  </div>
</ChapterSection>

<style>
  .manifesto-copy {
    position: relative;
    background: var(--background);
    box-shadow: 0 0 48px 28px var(--background);
  }
  :global(#manifesto.manifesto-chapter) {
    background: var(--background);
  }
  .manifesto-phrases {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 3rem;
  }
  .manifesto-phrases li {
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
    perspective: 900px;
    font-size: clamp(1.9rem, 4.7vw, 4.3rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.045em;
  }
  .manifesto-phrases li:last-child {
    border-bottom: 1px solid var(--border);
  }
</style>

<script>
  import "./manifesto"
</script>
