---
import ChapterSection from "@/components/journey/ChapterSection.astro"
import { manifesto } from "@/lib/site"
---

<ChapterSection id="manifesto" label="Cómo pienso" class="manifesto-chapter">
  <h2 class="max-w-md text-lg leading-relaxed text-muted-foreground sm:text-xl">
    {manifesto.title}
  </h2>
  <ul class="manifesto-phrases" aria-label="Mi forma de trabajar">
    {manifesto.phrases.map((phrase) => <li data-manifesto-phrase>{phrase}</li>)}
  </ul>
  <a class="manifesto-next" href="#vibo">Así toma forma en Vibo</a>
</ChapterSection>

<style>
  :global(#manifesto.manifesto-chapter) {
    background: color-mix(in oklch, var(--background) 80%, transparent);
  }
  .manifesto-phrases {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    margin-top: 3rem;
  }
  .manifesto-phrases li {
    font-size: clamp(1.9rem, 4.7vw, 4.3rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.045em;
  }
  .manifesto-next {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 3rem;
    font-size: 0.9rem;
    text-decoration: underline;
    text-underline-offset: 0.4em;
  }
  .manifesto-next:focus-visible {
    outline: 2px solid #91baff;
    outline-offset: 6px;
  }
</style>

<script>
  import "./manifesto"
</script>
