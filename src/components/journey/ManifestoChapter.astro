---
import ChapterSection from "@/components/journey/ChapterSection.astro"
import { manifesto } from "@/lib/site"
---

<ChapterSection id="manifesto" label="Cómo pienso" class="manifesto-chapter">
  <div class="manifesto-copy">
    <h2
      class="max-w-md text-lg leading-relaxed text-muted-foreground sm:text-xl"
    >
      {manifesto.title}
    </h2>
    <ul class="manifesto-phrases" aria-label="Mi forma de trabajar">
      {
        manifesto.phrases.map((phrase) => (
          <li data-manifesto-phrase>{phrase}</li>
        ))
      }
    </ul>
  </div>
</ChapterSection>

<style>
  .manifesto-copy {
    position: relative;
    max-width: 51rem;
  }
  :global(#manifesto.manifesto-chapter) {
    min-height: 100svh;
    justify-content: flex-start;
  }
  :global(#manifesto.manifesto-chapter > div) {
    padding-top: clamp(2rem, 5svh, 3rem);
  }
  .manifesto-phrases {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 3rem;
  }
  .manifesto-phrases li {
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
    perspective: 900px;
    font-size: clamp(1.9rem, 4.7vw, 4.3rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.045em;
  }
  .manifesto-phrases li:last-child {
    border-bottom: 1px solid var(--border);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(#manifesto.manifesto-chapter) {
      min-height: auto;
    }
  }
</style>

<script>
  import "./manifesto"
</script>
