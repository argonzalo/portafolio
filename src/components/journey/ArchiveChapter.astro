---
/**
 * Tercera línea — Desarrollos y archivo de proyectos.
 * Grilla interactiva de proyectos con dialog de detalle (T-A33).
 */
import ChapterSection from "@/components/journey/ChapterSection.astro"
import { ThirdLineGrid } from "@/components/journey/ThirdLineGrid"
import { getProjectsByTier } from "@/lib/projects"

const archive = getProjectsByTier(3)
---

<ChapterSection
  id="archive"
  label="Tercera línea"
  tall={false}
  class="bg-background/70 backdrop-blur-[2px]"
>
  <div class="max-w-4xl">
    <p
      class="text-muted-foreground text-xs font-semibold tracking-wider uppercase"
    >
      Tercera línea · Archivo
    </p>
    <h2
      class="mt-2 max-w-2xl text-3xl font-bold tracking-tight text-white text-balance sm:text-4xl"
    >
      Desarrollos y exploraciones.
    </h2>
    <p class="text-muted-foreground mt-3 max-w-2xl text-base leading-relaxed text-pretty">
      Soluciones a medida, aplicaciones de gestión interna, herramientas comerciales y prototipos experimentales.
      Desarrollos con foco en necesidades puntuales, construidos con rigor técnico y foco en el impacto real.
    </p>
  </div>

  <ThirdLineGrid client:load projects={archive} />
</ChapterSection>
