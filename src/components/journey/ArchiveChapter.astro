---
/**
 * Placeholder del archivo de tercera línea (interacción en T-A33).
 */
import ChapterSection from "@/components/journey/ChapterSection.astro"
import { buttonVariants } from "@/components/ui/button"
import { getProjectsByTier } from "@/lib/projects"

const archive = getProjectsByTier(3)
---

<ChapterSection
  id="archive"
  label="Archivo"
  tall={false}
  class="bg-background/50"
>
  <p
    class="text-muted-foreground text-sm font-medium tracking-wide uppercase"
  >
    Archivo · placeholder T-A33
  </p>
  <h2
    class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight text-balance sm:text-4xl"
  >
    Tercera línea
  </h2>
  <p class="text-muted-foreground mt-3 max-w-xl text-base leading-relaxed">
    Proyectos más breves, accesibles también desde la vista lista. La
    interacción 2D del archivo llega en T-A33.
  </p>
  <ul class="mt-8 flex flex-col gap-2" aria-label="Proyectos del archivo">
    {
      archive.map((project) => (
        <li>
          <a
            href={`/projects/${project.id}`}
            class="text-foreground hover:text-primary text-base font-medium underline-offset-4 hover:underline"
          >
            {project.title}
          </a>
          <span class="text-muted-foreground"> — {project.oneLiner}</span>
        </li>
      ))
    }
  </ul>
  <a
    href="/projects"
    class={buttonVariants({
      variant: "secondary",
      size: "lg",
      className: "mt-8 w-fit",
    })}
  >
    Ver todos en lista
  </a>
</ChapterSection>
