---
/**
 * Quién soy — Presentación personal definitiva.
 * Enfoque en la resolución de problemas, curiosidad interdisciplinaria y facetas humanas.
 */
import ChapterSection from "@/components/journey/ChapterSection.astro"
import { buttonVariants } from "@/components/ui/button"
import { site } from "@/lib/site"
---

<ChapterSection id="about" label="Quién soy" tall={false} class="bg-background/60">
  <div class="max-w-4xl">
    <p
      class="text-muted-foreground text-xs font-semibold tracking-wider uppercase"
    >
      Quién soy
    </p>
    <h2
      class="mt-2 max-w-2xl text-3xl font-bold tracking-tight text-white text-balance sm:text-4xl"
    >
      Curiosidad, criterio y foco en el problema real.
    </h2>

    <div
      class="text-muted-foreground mt-8 flex flex-col gap-5 text-base leading-relaxed text-pretty sm:text-lg"
    >
      <p>
        Diseño y construyo productos digitales donde la ingeniería, la inteligencia artificial
        y la experiencia de usuario se encuentran. Más que definirme por una tecnología o un framework
        en particular, me interesa entender la raíz de cada desafío: qué necesita el negocio, qué le duele al
        usuario y cuál es la forma más clara y elegante de resolverlo.
      </p>
    </div>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a
        href={site.instagram}
        class={buttonVariants({
          variant: "secondary",
          size: "default",
          className: "rounded-full border border-white/10 bg-white/5 hover:bg-white/15",
        })}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span
          class="icon-[tabler--brand-instagram] size-4 shrink-0 text-pink-400"
          aria-hidden="true"
        ></span>
        Instagram
      </a>

      <a
        href={site.linkedin}
        class={buttonVariants({
          variant: "secondary",
          size: "default",
          className: "rounded-full border border-white/10 bg-white/5 hover:bg-white/15",
        })}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span
          class="icon-[logos--linkedin-icon] size-4 shrink-0"
          aria-hidden="true"
        ></span>
        LinkedIn
      </a>
    </div>
  </div>
</ChapterSection>
