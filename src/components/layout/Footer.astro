---
import { site } from "@/lib/site"
---

<footer class="border-border mt-auto border-t">
  <div
    class="text-muted-foreground mx-auto flex w-full max-w-6xl flex-col gap-3 px-6 py-8 text-sm sm:flex-row sm:items-center sm:justify-between"
  >
    <p>{site.name}</p>
    <nav aria-label="Pie" class="flex flex-wrap gap-x-4 gap-y-1">
      <a href="/#archive" class="hover:text-foreground transition-colors">
        Proyectos
      </a>
      <a href="/#about" class="hover:text-foreground transition-colors">
        Quién soy
      </a>
      <a href="/#contact" class="hover:text-foreground transition-colors">
        Contacto
      </a>
      <a
        href={`mailto:${site.email}`}
        class="hover:text-foreground transition-colors"
      >
        {site.email}
      </a>
    </nav>
  </div>
</footer>
