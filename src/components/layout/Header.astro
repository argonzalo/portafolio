---
import { JourneyIndex } from "@/components/journey/JourneyIndex"
import { Logo } from "@/components/portfolio/Logo"
import { buttonVariants } from "@/components/ui/button"
import { site } from "@/lib/site"
---

<header
  class="pointer-events-none sticky top-0 z-40 flex w-full justify-center pt-[env(safe-area-inset-top)] transition-[top] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] data-[compact=true]:top-3"
  data-app-bar-root
>
  <div
    data-app-bar
    class="group bg-background/40 pointer-events-auto flex h-16 w-full justify-center border border-transparent shadow-[0_1px_0_0_var(--border)] backdrop-blur-lg transition-[border-radius,box-shadow,border-color] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] data-[compact=true]:rounded-full data-[compact=true]:border-border/50 data-[compact=true]:shadow-[0_8px_28px_-12px_rgba(0,0,0,0.16)]"
  >
    <div
      data-app-bar-inner
      class="mx-auto flex h-full w-full max-w-6xl flex-nowrap items-center gap-2 px-4 transition-[padding] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] sm:gap-3 sm:px-6 group-data-[compact=true]:px-3 sm:group-data-[compact=true]:px-4"
    >
      <a
        href="/"
        class="flex shrink-0 items-center gap-2.5 text-sm font-semibold tracking-tight"
      >
        <Logo size={24} backgroundClassName="bg-primary" />
        <span class="hidden md:inline">{site.name}</span>
      </a>

      <nav
        aria-label="Principal"
        class="ml-auto flex min-w-0 items-center gap-0.5 sm:gap-1"
      >
        <JourneyIndex client:load />
        <a
          href="/projects"
          class="text-muted-foreground hover:text-foreground hover:bg-muted/70 rounded-full px-2 py-1.5 text-xs whitespace-nowrap transition-colors sm:px-3 sm:text-sm"
        >
          Proyectos
        </a>
        <a
          href="/#contact"
          class="text-muted-foreground hover:text-foreground hover:bg-muted/70 rounded-full px-2 py-1.5 text-xs whitespace-nowrap transition-colors sm:px-3 sm:text-sm"
        >
          Contacto
        </a>
        <a
          href={`mailto:${site.email}`}
          class={buttonVariants({
            variant: "default",
            size: "sm",
            className: "ml-1 hidden rounded-full sm:inline-flex",
          })}
        >
          Hablemos
        </a>
      </nav>
    </div>
  </div>
</header>

<script>
  import { initAppBar } from "@/components/interactive/appBar"
  import { initHashScroll } from "@/lib/hashScroll"

  document.addEventListener("astro:page-load", () => {
    initAppBar()
    initHashScroll()
  })
</script>
