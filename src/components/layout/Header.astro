---
import { Logo } from "@/components/portfolio/Logo"
import { navigation, site } from "@/lib/site"

const currentPath = Astro.url.pathname
---

<header
  class="border-border/80 bg-background/80 sticky top-0 z-40 border-b backdrop-blur-md"
  transition:persist
>
  <div
    class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between gap-6 px-6"
  >
    <a
      href="/"
      class="flex items-center gap-2.5 text-sm font-semibold tracking-tight"
    >
      <Logo size={24} />
      {site.name}
    </a>
    <nav aria-label="Principal" class="hidden items-center gap-1 md:flex">
      {
        navigation.map((item) => {
          const isActive =
            item.href === "/"
              ? currentPath === "/"
              : currentPath.startsWith(item.href)

          return (
            <a
              href={item.href}
              aria-current={isActive ? "page" : undefined}
              class:list={[
                "rounded-md px-3 py-2 text-sm transition-colors",
                isActive
                  ? "text-foreground bg-muted"
                  : "text-muted-foreground hover:text-foreground hover:bg-muted/70",
              ]}
            >
              {item.label}
            </a>
          )
        })
      }
    </nav>
    <a
      href="/contact"
      class="text-muted-foreground hover:text-foreground text-sm md:hidden"
    >
      Contacto
    </a>
  </div>
</header>
